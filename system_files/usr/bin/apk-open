#!/usr/bin/env bash
# apk-open: instala .apk no Waydroid (duplo clique)
set -euo pipefail
. /usr/libexec/emu-common.sh

[ $# -ge 1 ] || { echo "Uso: apk-open <app.apk>" >&2; exit 1; }
FILE="$(realpath -- "$1")"
[ -f "$FILE" ] && [[ "${FILE,,}" == *.apk ]] || { notify "Arquivo inválido" "$FILE"; exit 1; }
command -v waydroid >/dev/null || { notify "Waydroid não está instalado"; exit 1; }
[ -f /var/lib/waydroid/.extras-done ] || {
    notify "Waydroid ainda está sendo preparado" "Acompanhe: journalctl -u waydroid-firstboot -f"; exit 1; }

running() { waydroid status 2>/dev/null | grep -Eq '^Session:[[:space:]]+RUNNING'; }

if ! running; then
    notify "Iniciando o Android" "Aguarde alguns segundos..."
    systemctl --user start waydroid-session.service 2>/dev/null || { nohup waydroid session start >/dev/null 2>&1 & }
    for _ in $(seq 1 60); do running && break; sleep 2; done
fi
running || { notify "Não consegui iniciar a sessão do Waydroid"; exit 1; }

for _ in 1 2 3 4 5; do
    if waydroid app install "$FILE"; then notify "APK instalado" "$(basename "$FILE")"; exit 0; fi
    sleep 10   # o Android ainda pode estar terminando o boot
done
notify "Falha ao instalar o APK" "Rode 'waydroid app install' no terminal para ver o erro."
exit 1
