#!/usr/bin/env bash
# xenia-open: abre .xex / ISO de Xbox 360 no Xenia Canary (Proton)
set -euo pipefail
. /usr/libexec/emu-common.sh
XENIA_PROTON="GE-Proton"; XENIA_ARGS=""; XENIA_EXTRA_CONTENT_DIRS=""
load_conf

BASE="${XDG_DATA_HOME:-$HOME/.local/share}/xenia-canary"
PFX="$BASE/prefix"
[ -f "$BASE/exe-path" ] || /usr/bin/xenia-setup || exit 1
EXE="$(cat "$BASE/exe-path")"

is_x360_iso() {   # procura a assinatura do XDVDFS nos offsets de XISO, XGD1, XGD2 e XGD3
    local off
    for off in $((0x10000)) $((0xFDA0000)) $((0x2090000)) $((0x20A0000)) $((0x18310000)); do
        [ "$(dd if="$1" bs=20 count=1 skip="$off" iflag=skip_bytes 2>/dev/null | tr -d "\0")" = "MICROSOFT*XBOX*MEDIA" ] && return 0
    done
    return 1
}

FILE=""; GAMEDIR=""
if [ $# -ge 1 ]; then
    FILE="$(realpath -- "$1")"
    [ -f "$FILE" ] || { notify "Arquivo não encontrado" "$FILE"; exit 1; }
    case "${FILE,,}" in
        *.xex) ;;
        *.iso)
            if ! is_x360_iso "$FILE"; then       # não é Xbox 360: monta como imagem de disco comum
                if command -v udisksctl >/dev/null; then exec udisksctl loop-setup --file "$FILE"; fi
                notify "Esta ISO não é de Xbox 360" "$FILE"; exit 1
            fi ;;
        *) notify "Tipo de arquivo não suportado" "$FILE"; exit 1 ;;
    esac
    GAMEDIR="$(dirname "$FILE")"
fi

# DLC e Title Updates: pastas ao lado do jogo + pastas extras da configuração
if [ -n "$GAMEDIR" ]; then
    for sub in DLC TU "Title Updates" Updates; do
        [ -d "$GAMEDIR/$sub" ] && /usr/bin/xenia-content "$GAMEDIR/$sub" || true
    done
fi
IFS=: read -ra EXTRA <<<"$XENIA_EXTRA_CONTENT_DIRS"
for d in "${EXTRA[@]}"; do [ -n "$d" ] && [ -d "$d" ] && /usr/bin/xenia-content "$d" || true; done

export WINEPREFIX="$PFX" PROTONPATH="$XENIA_PROTON" GAMEID=0
cd "$(dirname "$EXE")"
if [ -n "$FILE" ]; then
    export STEAM_COMPAT_LIBRARY_PATHS="$GAMEDIR:${STEAM_COMPAT_LIBRARY_PATHS:-}"   # o container do Steam Runtime precisa enxergar a pasta
    # shellcheck disable=SC2086
    exec umu-run "$EXE" "Z:${FILE//\//\\}" $XENIA_ARGS
fi
# shellcheck disable=SC2086
exec umu-run "$EXE" $XENIA_ARGS
