#!/usr/bin/env bash
# shadps4-open: abre o eboot.bin de um jogo de PS4 no shadPS4
set -euo pipefail
. /usr/libexec/emu-common.sh

[ $# -ge 1 ] || { echo "Uso: shadps4-open <eboot.bin>" >&2; exit 1; }
FILE="$(realpath -- "$1")"
[ -f "$FILE" ] || { notify "Arquivo não encontrado" "$FILE"; exit 1; }

case "$(od -An -tx1 -N4 -- "$FILE" | tr -d ' \n')" in
    4f153d1d|7f454c46) ;;   # SELF de PS4 ou ELF
    53434500) notify "Isto parece um EBOOT de PS3" "Use o RPCS3."; exit 1 ;;
    *) notify "Não parece um executável de PS4" "$FILE"; exit 1 ;;
esac

BIN="$(command -v shadps4 || true)"
for c in "$HOME/.local/bin/shadps4" /usr/local/bin/shadps4; do
    [ -n "$BIN" ] && break; [ -x "$c" ] && BIN="$c"
done
[ -n "$BIN" ] || { notify "shadPS4 não instalado" "Rode: shadps4-update"; exit 1; }
exec "$BIN" "$FILE"
