#!/usr/bin/env python3
"""Tela de boas-vindas do Ventos OS (primeiro login). --first-run: só abre se ainda não foi dispensada."""
import os
import subprocess
import sys
from pathlib import Path

HERE = Path("/usr/lib/ventos/welcome")
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "ventos"
MARK = STATE / "welcome-done"

PAGES = [
    {"title": "Bem-vindo ao Ventos OS",
     "body": "Um sistema imutável baseado em Fedora Kinoite (KDE Plasma): ele se atualiza por imagem, "
             "é difícil de quebrar e traz jogos, emuladores e Android prontos para usar.\n\n"
             "Esta tela explica o essencial. Você pode reabri-la a qualquer momento pelo menu: “Boas-vindas”."},
    {"title": "Menu e barra de tarefas",
     "body": "• A barra fica embaixo: menu de aplicativos à esquerda, programas abertos no meio, bandeja do sistema e relógio à direita.\n"
             "• A tecla Super (Windows) abre o menu.\n"
             "• Os ícones da área de trabalho funcionam com duplo clique.\n"
             "• Ctrl+Shift+Esc abre o Gerenciador de Tarefas (processos, CPU, RAM, GPU, disco e rede)."},
    {"title": "Pesquisa e atalhos",
     "body": "• Super+S ou Alt+Espaço: pesquisa global (aplicativos, arquivos, configurações, calculadora, conversões e web).\n"
             "• Super+R: executar comando, abrir pastas, programas e arquivos.\n"
             "• Super+E: Dolphin (pasta pessoal)   • Super+L: bloquear   • Super+D: mostrar a área de trabalho\n"
             "• Alt+Tab ou Super+Tab: alternar janelas\n"
             "• Teclado virtual: aparece sozinho em telas touch; para abrir à mão, procure “Teclado virtual” no menu."},
