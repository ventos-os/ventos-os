#!/usr/bin/env bash
# Instala os Flatpaks de /usr/share/ventos/flatpaks.list (idempotente; o serviço repete até tudo instalar)
set -uo pipefail
LIST=/usr/share/ventos/flatpaks.list
fail=0

while read -r app opts; do
    [[ -z "$app" || "$app" == \#* ]] && continue
    if ! flatpak info --system "$app" >/dev/null 2>&1; then
        echo ">> instalando $app"
        flatpak install --system --noninteractive --assumeyes flathub "$app" \
            || { echo "falha ao instalar $app" >&2; fail=1; continue; }
    fi
    if [ -n "${opts:-}" ]; then
        # shellcheck disable=SC2086
        flatpak override --system $opts "$app"
    fi
done < "$LIST"

[ "$fail" -eq 0 ] && touch /var/lib/ventos-flatpaks-done
exit "$fail"
