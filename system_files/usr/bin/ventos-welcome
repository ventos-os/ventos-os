def main() -> int:
    if "--first-run" in sys.argv and MARK.exists():
        return 0
    from PySide6.QtCore import QObject, QUrl, Slot
    from PySide6.QtGui import QGuiApplication
    from PySide6.QtQml import QQmlApplicationEngine

    class Welcome(QObject):
        @Slot(bool)
        def finish(self, dont_show_again):
            if dont_show_again:
                STATE.mkdir(parents=True, exist_ok=True)
                MARK.touch()
            QGuiApplication.quit()

        @Slot()
        def openGameMode(self):
            subprocess.Popen(["/usr/bin/ventos-modojogo", "--windowed"], start_new_session=True)

    os.environ.setdefault("QT_QUICK_CONTROLS_STYLE", "Basic")
    app = QGuiApplication([sys.argv[0]])
    app.setApplicationName("ventos-welcome")
    welcome = Welcome()
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("welcome", welcome)
    engine.rootContext().setContextProperty("pages", PAGES)
    engine.load(QUrl.fromLocalFile(str(HERE / "welcome.qml")))
    if not engine.rootObjects():
        return 1
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
